# ==============================================================================
#      TEMPLATE: Environment Variables for n8n Workers Stack
# ==============================================================================
# This file is a template. DO NOT store secrets here.

#----------------------------------------------------------------------
#=[ 1. GLOBAL CONFIGURATION ]=
#----------------------------------------------------------------------
TZ=America/Monterrey
GENERIC_TIMEZONE=America/Monterrey

# -- Custom Domains --
SERVICE_URL_N8N=n8n.your-domain.com
N8N_PROTOCOL=https

#----------------------------------------------------------------------
#=[ 2. SECRETS & CREDENTIALS ]=
#----------------------------------------------------------------------
SERVICE_USER_POSTGRES=your_db_user
SERVICE_PASSWORD_POSTGRES=changeme_your_strong_db_password
SERVICE_PASSWORD_N8N=changeme_your_secure_n8n_password
SERVICE_PASSWORD_ENCRYPTION=changeme_your_encryption_key

#----------------------------------------------------------------------
#=[ 3. DATABASE & CACHE CONFIGURATION ]=
#----------------------------------------------------------------------
POSTGRES_DB=n8n

#----------------------------------------------------------------------
#=[ 4. N8N SMTP CONFIGURATION ]=
#----------------------------------------------------------------------
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=your.smtp.host
N8N_SMTP_PORT=587
N8N_SMTP_USER=your_smtp_user@your-domain.com
N8N_SMTP_PASS=changeme_your_smtp_password
N8N_SMTP_SENDER="Your n8n Sender Name"
N8N_SMTP_SSL=true
